# ---- Server ----
PORT=5000
NODE_ENV=development
# Frontend URL(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:5173

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=put_your_postgres_password_here
DB_NAME=store_rating_platform

# ---- JWT ----
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# ---- Default admin created by `npm run db:setup` ----
# Name must be 20-60 chars, password 8-16 chars with 1 uppercase + 1 special char
ADMIN_NAME=System Administrator Account
ADMIN_EMAIL=admin@platform.com
ADMIN_PASSWORD=Admin@12345
ADMIN_ADDRESS=Head Office, Pune, Maharashtra, India
