              "mode": "raw",
              "raw": "{\n  \"name\": \"Another Test Person Account 02\",\n  \"email\": \"another.user@test.com\",\n  \"password\": \"Passw0rd!x\",\n  \"address\": \"Pune\",\n  \"role\": \"USER\"\n}"
