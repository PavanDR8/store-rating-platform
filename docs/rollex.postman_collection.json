            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/stores?search=&sortBy=avg_rating&order=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "stores"
              ],
              "query": [
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "sortBy",
                  "value": "avg_rating"
                },
                {
                  "key": "order",
                  "value": "desc"
                }
              ]
            }
          }
        },
        {
          "name": "Owners without a store",
