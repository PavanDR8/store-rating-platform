              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Store\",\n  \"email\": \"postman.store@test.com\",\n  \"address\": \"Shop 5, FC Road, Pune\",\n  \"owner\": {\n    \"name\": \"Postman Store Owner Account 03\",\n    \"email\": \"postman.owner@test.com\",\n    \"password\": \"Passw0rd!x\",\n    \"address\": \"Pune\"\n  }\n}"
            }
          }
        },
        {
          "name": "List users (search, filter, sort)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users?search=postman&role=USER&sortBy=name&order=asc&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "postman"
                },
                {
                  "key": "role",
                  "value": "USER"
                },
                {
                  "key": "sortBy",
                  "value": "name"
                },
                {
                  "key": "order",
                  "value": "asc"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "User details",
          "request": {
            "method": "GET",
            "header": [
